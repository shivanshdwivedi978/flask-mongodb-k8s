# MongoDB Configuration
MONGO_USERNAME=admin
MONGO_PASSWORD=password123
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=flask_db
MONGO_AUTH_SOURCE=admin

# MongoDB Full Connection URI
MONGODB_URI=mongodb://admin:password123@mongodb:27017/flask_db?authSource=admin

# Application Server
PORT=5000
FLASK_ENV=development
